# Copy this file to .env and fill in real values
PORT=3000

# Shared secret Vapi will send back to verify requests are really from Vapi.
# You'll set this same value in Vapi's Tool > Authorization > Custom Credential.
VAPI_WEBHOOK_SECRET=replace_with_a_long_random_string

# --- Fill these in once you connect real data sources ---
# ORDER_DB_URL=
# CRM_API_KEY=
# TICKETING_API_KEY=
